[Unit]
Description=solos-data Phoenix finalized transaction collector
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=%h/solos-data
EnvironmentFile=%h/.config/solos-data/collector.env
# DuckDB's buffer limit. 32GB ran out when the live tail and the archive backfill wrote together
# (2026-10-14 incident: a failed commit then wedged both lanes); raised to 64GB on 2026-10-15.
# MemoryMax below still bounds the whole process, archive range buffers included.
Environment=SOLOS_DATA_DB_MEMORY=64GB
ExecStart=%h/.local/share/solos-data/bin/solos-data collector run --config config/phoenix.json
Restart=always
RestartSec=15
TimeoutStopSec=60
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
MemoryMax=256G
TasksMax=1024
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
